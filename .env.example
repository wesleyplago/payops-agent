# Local / compose defaults. Never use these secrets outside the demo.
PORT=3000
DATABASE_URL=postgres://payops:payops@localhost:5432/payops
TEST_DATABASE_URL=postgres://payops:payops@localhost:5432/payops_test
APPROVER_SECRET=local-approver-secret-change-me
AGENT_API_KEY=local-agent-key-change-me
APPROVAL_TTL_MS=60000
APPROVAL_WAIT_MS=15000
OTEL_SERVICE_NAME=payops-agent
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACE_FILE=reports/otel-trace.json
SEND_PIX_ALLOWLIST=pix-demo-key,pix-vendor-001,pix-vendor-002
LOG_LEVEL=info

# Optional OpenAI-compatible decision model. Leave empty to use the deterministic boundary.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_INPUT_PRICE_PER_1M=0
LLM_OUTPUT_PRICE_PER_1M=0
